# Server Configuration (SaaS Branch)
PORT=1080
NODE_ENV=development

# MongoDB Configuration (SaaS Branch - 使用独立数据库)
# 数据库路径: data/db_saas
# 启动脚本: data/startdb_saas.sh
MONGO_HOST=localhost
MONGO_PORT=27028
MONGO_DATABASE=nldb_saas

# 开发环境暂不启用认证
# MONGO_USER=
# MONGO_PASSWORD=
# MONGO_AUTH_SOURCE=

# Session
SESSION_SECRET=your_session_secret_here

# Company (SaaS模式下由租户配置)
COMPANY_NAME=SaaS平台
