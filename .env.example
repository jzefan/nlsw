# Server Configuration
PORT=1080
NODE_ENV=development

# Deploy Mode: standalone | saas
# standalone — 单公司独立部署，无平台概念
# saas — SaaS 多租户部署，平台管理多公司
DEPLOY_MODE=standalone
# standalone 模式下的公司名称（saas 模式留空）
STANDALONE_COMPANY=江苏联润

# Self-Vehicle Management Feature (true=enabled, false=disabled)
# ⚠️ 重要：这是部署时配置，一旦系统开始运行就不应修改
# 功能关闭：所有运单 selfOwned=0，不区分自有/非自有车
# 功能启用：运单按 selfOwned=0/1 区分非自有/自有车
ENABLE_SELF_VEHICLE=false

# MongoDB Configuration
# Option 1: Full URI (takes precedence)
# MONGODB=mongodb://user:password@localhost:27027/nldb?authSource=admin

# Option 2: Individual settings
MONGO_HOST=localhost
MONGO_PORT=27027
MONGO_DATABASE=nldb
MONGO_USER=nldb_user
MONGO_PASSWORD=your_secure_password
MONGO_AUTH_SOURCE=nldb

# Session
SESSION_SECRET=your_session_secret_here

# Company
COMPANY_NAME=江苏联润
