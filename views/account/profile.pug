extends ../layout

block content
  .page-header
    h3 用户信息

  form.form-horizontal(action='/account/profile', method='POST')
    input(type='hidden', name='_csrf', value=_csrf)
    .form-group
      label.col-sm-2.control-label(for='userid') 用户名
      .col-sm-4
        input.form-control(type='text', name='userid', id='userid', value='#{user.userid}')
    .form-group
      label.col-sm-2.control-label(for='name') 真实名字
      .col-sm-4
        input.form-control(type='text', name='name', id='name', value='#{user.profile.name}')
    .form-group(style="display: flex; align-items: center; margin-top: 20px; margin-bottom: 20px")
      label.col-sm-2.control-label(for='gender', style="padding-top: 0") 性别
      .col-sm-6
        div(style="display: flex; align-items: center; gap: 15px;")
          div(style="display: flex; align-items: center; gap: 5px")
            input#male(type='radio', name='square-radio')
            label(for='male', style="margin-bottom: 0") 男
          div(style="display: flex; align-items: center; gap: 5px")
            input#female(type='radio', name='square-radio', style="margin-left: 15px;")
            label(for='female', style="margin-bottom: 0") 女
    .form-group
      label.col-sm-2.control-label(for='location') 地址
      .col-sm-4
        input.form-control(type='text', name='location', id='location', value='#{user.profile.location}')
    .form-group
      label.col-sm-2.control-label(for='phone') 电话
      .col-sm-4
        input.form-control(type='text', name='phone', id='phone', value='#{user.profile.phone}')
    .form-group
      label.col-sm-2.control-label(for='gravatar') 头像
      .col-sm-4
        img(src="#{user.gravatar()}", class='profile', width='100', height='100')
    .form-group
      .col-sm-offset-2.col-sm-4
        button.btn.btn.btn-primary(type='submit')
          i.fa.fa-magnet
          | &nbsp;&nbsp;更新信息

  .page-header
    h3 修改密码

  form.form-horizontal(action='/account/password', method='POST')
    input(type='hidden', name='_csrf', value=_csrf)
    .form-group
      label.col-sm-2.control-label(for='password') 新密码
      .col-sm-4
        input.form-control(type='password', name='password', id='password')
    .form-group
      label.col-sm-2.control-label(for='confirmPassword') 新密码确认
      .col-sm-4
        input.form-control(type='password', name='confirmPassword', id='confirmPassword')
    .form-group
      .col-sm-offset-2.col-sm-4
        button.btn.btn.btn-primary(type='submit')
          i.fa.fa-keyboard-o
          | &nbsp;&nbsp;修改密码

  .page-header
    h3 删除用户账号

  p 您可以删除您的账号，但是您的所有信息都不可恢复.
  form(action='/account/delete', method='POST')
    input(type='hidden', name='_csrf', value=_csrf)
    .form-group
      .col-sm-offset-1.col-sm-4
        button.btn.btn-danger(type='submit')
          i.fa.fa-trash-o
          | &nbsp;&nbsp;删除我的账号

