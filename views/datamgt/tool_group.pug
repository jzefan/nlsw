div(style="display: flex; align-items: center; gap: 15px")
  div.btn-group(style='margin-top:0px;')
    button#data-add.btn.btn-default
      i.fa.fa-plus-square-o
      | &nbsp;增加
    button#data-modify.btn.btn-default
      i.fa.fa-pencil-square-o
      | &nbsp;修改
    button#data-delete.btn.btn-default
      i.fa.fa-minus-square-o
      | &nbsp;删除
  div.btn-group(style='margin-top:0px;')
    button#data-export.btn.btn-default(data-toggle="popover", data-placement='bottom', data-content="导出为Excel文件格式")
      i.fa.fa-external-link-square
      | &nbsp;导出
  div.btn-group(style='margin-top:0px;')
    button#reset-passwd.btn.btn-default
      i.fa.fa-reset
      | &nbsp;重置密码
    //button#data-import.btn.btn-default
      i.fa.fa-share-square
      | &nbsp;导入

  div.btn-group#search-tool(style='margin-top:0px; display: flex; align-items: center; gap: 6px; height: 32px')
    span(for='data-search', style="font-size: 14px; margin-left: 10px;") 查询
    select#data-search(style='width:15em')
